generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Blog {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  metaTitle       String?
  metaDescription String?
  content         String
  featuredImg     String?
  imgAlt          String?
  author          String?
  category        String?
  createdAt       DateTime @default(now())
  // Author box on the post page (all optional)
  authorImage     String?
  authorLinkedin  String?
  authorEmail     String?
  authorPhone     String?
  authorBio       String?
  // Dates shown on the post; publishedAt is set when a post is first published if left empty
  publishedAt     DateTime?
  lastModifiedAt  DateTime?
  // "draft" posts are only visible in the admin; existing posts count as published
  status          String   @default("published")
}
